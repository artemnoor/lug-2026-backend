LUG_ENV=development
LUG_ROOT=.
LUG_APP_NAME=lug-api
LUG_BUILD_VERSION=dev
LUG_BUILD_SHA=unknown
LUG_ALLOWED_HOSTS=127.0.0.1,localhost
LUG_DATABASE_URL=sqlite+aiosqlite:///./data/lug.db
LUG_DATABASE_POOL_MIN_SIZE=2
LUG_DATABASE_POOL_MAX_SIZE=20
LUG_DATABASE_SSL_MODE=disable
LUG_DATABASE_SSL_ROOT_CERT=
REDIS_URL=
LUG_OPERATIONS_TOKEN=
LUG_TRUST_PROXY=false
LUG_TRUSTED_PROXY_IPS=
LUG_SECURE_COOKIES=false
LUG_SESSION_TTL_SECONDS=604800
LUG_MAX_JSON_BODY=2097152
LUG_MAX_UPLOAD_BODY=73400320
LUG_MAX_UPLOAD_BYTES=262144000
LUG_MAX_UPLOADS_PER_USER=50
LUG_MAX_UPLOAD_BYTES_PER_USER=262144000
LUG_UPLOAD_RATE_LIMIT_PER_IP=30
LUG_UPLOAD_RATE_LIMIT_PER_USER=30
LUG_FILE_STORAGE_PROVIDER=local
LUG_DATA_DIR=./data
LUG_UPLOAD_DIR=./uploads
LUG_UPLOAD_SCANNER=none
LUG_UPLOAD_SCANNER_HOST=clamav
LUG_UPLOAD_SCANNER_PORT=3310
LUG_UPLOAD_SCANNER_TIMEOUT_SECONDS=30
LUG_UPLOAD_SCAN_COMMAND=
# Keep this for deployments that invoke a scanner binary inside the API host.
# Compose uses the networked ClamAV adapter instead.
LUG_UPLOAD_SCAN_REQUIRED=false
LUG_S3_BUCKET=
LUG_S3_REGION=
LUG_S3_ENDPOINT_URL=
LUG_S3_ACCESS_KEY=
LUG_S3_SECRET_KEY=
LUG_S3_FORCE_PATH_STYLE=false
LUG_S3_PREFIX=uploads
LUG_S3_SIGNED_URL_TTL=300
LUG_S3_SERVER_SIDE_ENCRYPTION=AES256
LUG_S3_KMS_KEY_ID=
LUG_ADMIN_EMAIL=admin@lug.local
LUG_ADMIN_PASSWORD=Strong!Admin1
LUG_EMAIL_MODE=log
LUG_EMAIL_VERIFICATION_SECRET=local-development-email-secret
LUG_EMAIL_VERIFICATION_TTL_SECONDS=900
LUG_EMAIL_VERIFICATION_COOLDOWN_SECONDS=60
LUG_EMAIL_VERIFICATION_MAX_ATTEMPTS=5
LUG_EMAIL_LOG_CODE=true
LUG_SMTP_HOST=
LUG_SMTP_PORT=587
LUG_SMTP_USER=
LUG_SMTP_PASSWORD=
LUG_SMTP_FROM=no-reply@lug.local
LUG_SMTP_FROM_NAME=LUG 2026
LUG_SMTP_STARTTLS=true
LUG_SMTP_SSL=false
LOG_LEVEL=INFO
